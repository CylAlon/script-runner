{
  "scripts": [
    {
      "label": "$(rocket) 测试带参数脚本",
      "description": "演示参数选择功能",
      "command": "echo '端口: {port}, 环境: {env}'",
      "params": [
        {
          "name": "port",
          "label": "端口号",
          "options": [
            { "label": "3000", "value": "3000" },
            { "label": "8080", "value": "8080" },
            { "label": "9000", "value": "9000" }
          ]
        },
        {
          "name": "env",
          "label": "运行环境",
          "options": [
            { "label": "开发环境", "value": "development" },
            { "label": "生产环境", "value": "production" },
            { "label": "测试环境", "value": "test" }
          ]
        }
      ]
    },
    {
      "label": "$(terminal) 普通脚本",
      "description": "没有参数的脚本",
      "command": "echo '这是一个普通脚本'"
    }
  ]
}
